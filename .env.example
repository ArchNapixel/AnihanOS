# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client (Vite only exposes vars prefixed with VITE_ to the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:4000
VITE_MAPTILER_KEY=

# Server
PORT=4000

# Shared secret for the Vercel Cron weather sync (GET /api/weather/sync).
# Required in production — without it the endpoint rejects every request,
# so the daily weather/humidity sync silently stops running.
CRON_SECRET=
