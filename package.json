{
  "name": "anihanos",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green --kill-others \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
